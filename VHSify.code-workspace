{
  // Open the project through this file. Each piece of configuration is defined in one place only:
  //   - here: the folder and every setting;
  //   - .vscode/extensions.json, .vscode/tasks.json, .vscode/launch.json: recommendations, tasks and debugging.
  // Keep "extensions", "tasks" and "launch" out of this file and don't add a .vscode/settings.json: folder
  // settings override workspace settings, so the same key would end up with two competing values.
  "folders": [
    {
      "name": "VHSify",
      "path": "."
    }
  ],
  "settings": {
    // Repository conventions: LF line endings (a CRLF vhsify.sh breaks bash), one final newline, no trailing
    // whitespace, and spaces for indentation: 4 in vhsify.sh and vhsify.ps1, 2 in the workflows, JSON and site/.
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "[yaml]": {
      "editor.tabSize": 2
    },
    "[json]": {
      "editor.tabSize": 2
    },
    "[jsonc]": {
      "editor.tabSize": 2
    },
    "[html]": {
      "editor.tabSize": 2
    },
    "[css]": {
      "editor.tabSize": 2
    },

    // vhsify.ps1 keeps the closing brace and the next keyword on one line ("} else {", "} finally {").
    "powershell.codeFormatting.preset": "OTBS"
  }
}
